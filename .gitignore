# ==============================================================================
# Personal AI Assistant - Comprehensive .gitignore
# ==============================================================================

# Environment variables & secrets (NEVER commit live secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python bytecode, compiled objects & caches
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node.js & package manager caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs & frontend bundles
dist/
dist-ssr/
build/
.cache/
.vite/

# Application logs & crash reports
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Local databases, vectors & cache state
*.local_mongo.json
.local_mongo.json
local_history.json
*.sqlite
*.db

# Uploaded documents & user data (ignore files, keep folder structure)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
test_gen.pdf

# IDE and OS metadata files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
